APP_NAME="Promolux CRM"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://soleyev.uz/promolux
ASSET_URL=https://soleyev.uz/promolux
APP_VERSION=0.3.1
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE_NAME
DB_USERNAME=CPANEL_DATABASE_USER
DB_PASSWORD=
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_COOKIE=promolux_crm_session
SESSION_PATH=/promolux
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
